# Where FastAPI runs locally. Vite forwards browser /api/* requests there.
BACKEND_PROXY_TARGET=http://127.0.0.1:8000

# Set these after the matching FastAPI OAuth start endpoints exist.
# Paths must begin with /api/ and be on the same origin.
VITE_GOOGLE_OAUTH_START_PATH=
VITE_GITHUB_OAUTH_START_PATH=
