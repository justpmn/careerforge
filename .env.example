APP_NAME=CareerForge API
APP_VERSION=0.1.0
DEBUG=true
POSTGRES_DB=careerforge
POSTGRES_USER=careerforge
POSTGRES_PASSWORD=YOUR_PASSWORD_HERE
DATABASE_URL=postgresql+psycopg://careerforge:change-me@localhost:5432/careerforge
VITE_GITHUB_OAUTH_START_PATH=/api/auth/oauth/github/start
VITE_GOOGLE_OAUTH_START_PATH=/api/auth/oauth/google/start