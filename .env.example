APP_NAME=CareerForge API
APP_VERSION=0.1.0
DEBUG=true
POSTGRES_DB=your_db
POSTGRES_USER=your_user
POSTGRES_PASSWORD=YOUR_PASSWORD_HERE
DATABASE_URL=postgresql+psycopg://your_user:your_password@localhost:PORT/db
VITE_GITHUB_OAUTH_START_PATH=/api/auth/oauth/github/start
VITE_GOOGLE_OAUTH_START_PATH=/api/auth/oauth/google/start

JWT_SECRET_KEY=generate_your_secret

//Oauth
//Github
GITHUB_OAUTH_CLIENT_ID=your-oauth_credentials
GITHUB_OAUTH_CLIENT_SECRET==your-secret

//GOOGLE
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET

OAUTH_STATE_SECRET_KEY=
OAUTH_REDIRECT_ORIGIN=http://localhost:$PORT
JWT_ACCESS_TOKEN_EXPIRE_MINUTE=

EMAIL_DELIVERY_MODE=
FRONTEND_PUBLIC_ORIGIN=http://localhost:$PORT


//MFA
MFA_ENCRYPTION_KEY=

//Email Sending service
CAREERFORGE_SMTP_USER=
CAREERFORGE_SMTP_APP_PASSWORD=
CAREERFORGE_MAIL_NAME=
CAREERFORGE_EMAIL_LOGO_PATH=

//cloudflare if on cloudflare or if you have a local model on ollama then ollama
LLM_PROVIDER= ollama/cloudflare

//cloudflare credentials
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_MODEL